{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/sync-docs.sh\" pull",
            "timeout": 60,
            "statusMessage": "Pulling team docs from GitHub"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/sync-docs.sh\" push",
            "timeout": 90,
            "statusMessage": "Pushing team docs to GitHub"
          }
        ]
      }
    ]
  }
}
